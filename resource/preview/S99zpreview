#!/bin/sh

BASE=/mnt/system/bf01-preview
PREVIEW=$BASE/bf01-preview
[ -x "$BASE/ipcamera" ] || exit 0
case "$1" in
    start)
        "$BASE/auto.sh" >/run/bf01-preview-boot.log 2>&1 </dev/null &
        ;;
    stop)
        "$PREVIEW" stop
        ;;
    restart)
        "$PREVIEW" stop || exit 1
        "$BASE/auto.sh" >/run/bf01-preview-boot.log 2>&1 </dev/null &
        ;;
    *) echo 'Usage: S99zpreview {start|stop|restart}' >&2; exit 1 ;;
esac
